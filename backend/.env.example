# Neon PostgreSQL (https://neon.tech)
# In the Neon console: Connection details → copy both URLs.
# - DATABASE_URL: "Pooled connection" (host contains -pooler) — used by the app
# - DIRECT_URL: "Direct connection" — used by Prisma Migrate only
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

PORT=5000
NODE_ENV=development
# In production, set strong unique values for JWT_SECRET (32+ chars),
# ADMIN_PASSWORD (12+ chars), and IP_HASH_SALT (16+ chars). The server
# refuses to start with weak defaults when NODE_ENV=production.
JWT_SECRET="super-secret-change-me"
JWT_EXPIRES_IN="12h"
ADMIN_USERNAME="mlsa-admin"
ADMIN_PASSWORD="mlsa-secure-password"
CORS_ORIGIN="http://localhost:5173"
IP_HASH_SALT="mlsa-anonymous-salt"
SUBMISSION_RATE_LIMIT_WINDOW_MS=900000
SUBMISSION_RATE_LIMIT_MAX=8
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
