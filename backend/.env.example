# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

PORT=5000
NODE_ENV=development

JWT_SECRET="change-me-in-production-use-32-plus-chars"
JWT_EXPIRES_IN="12h"
ADMIN_USERNAME="mlsa-admin"
ADMIN_PASSWORD="mlsa-secure-password"
CORS_ORIGIN="http://localhost:5173"
IP_HASH_SALT="mlsa-anonymous-salt"

SUBMISSION_RATE_LIMIT_WINDOW_MS=900000
SUBMISSION_RATE_LIMIT_MAX=8

# Optional Cloudinary attachments
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Admin alerts (optional; use Discord, email, or both) ---
# Discord: Server Settings → Integrations → Webhooks → New Webhook → copy URL
DISCORD_WEBHOOK_URL=""
# Optional @mentions (comma-separated numeric IDs). Enable Developer Mode in Discord,
# then right-click a user → Copy User ID, or Server Settings → Roles → copy role ID.
DISCORD_MENTION_USER_IDS=""
DISCORD_MENTION_ROLE_IDS=""

# Email: comma-separated recipients + SMTP (Gmail, Outlook, SendGrid SMTP, etc.)
ADMIN_NOTIFY_EMAIL=""
ADMIN_DASHBOARD_URL="https://your-frontend.vercel.app/admin"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MLSA Feedback <noreply@yourdomain.com>"
